<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RMP2.ViewModel"
             x:Class="RMP2.View.MainPage"
             Style="{StaticResource ContentPageStyle}">

    <Grid
        BindingContext="{x:Static vm:MainVM.Instance}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Entry
            Grid.Row="0"
            Text="{Binding SearchString}"
            Placeholder="Поиск"/>
        <ListView 
            x:Name="notesListView"
            Grid.Row="1" 
            ItemsSource="{Binding DisplayedNotes}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <VerticalStackLayout 
                            Padding="10, 0, 0, 0">
                            <Label 
                                Text="{Binding Name}"
                                FontAttributes="Bold"/>
                            <Label 
                                Text="{Binding CreationTime}"/>
                        </VerticalStackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid
            Grid.Row="2"
            Margin="0, 10, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Text="Изменить"
                Margin="3"
                Command="{Binding OpenPageForEditingNoteCommand}"
                CommandParameter="{Binding SelectedItem, Source={x:Reference notesListView}}"/>
            <Button
                Grid.Column="1"
                Text="Создать"
                Margin="3"
                Command="{Binding OpenPageForCreatingNoteCommand}"/>
            <Button
                Grid.Column="2"
                Text="Удалить"
                Margin="3"
                BackgroundColor="Red"
                Command="{Binding DeleteCommand}"
                CommandParameter="{Binding SelectedItem, Source={x:Reference notesListView}}"/>
        </Grid>
    </Grid>

</ContentPage>