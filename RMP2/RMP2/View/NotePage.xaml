<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:v="clr-namespace:RMP2.View"
             xmlns:vm="clr-namespace:RMP2.ViewModel"
             x:Class="RMP2.View.NotePage"
             Style="{StaticResource ContentPageStyle}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <v:AppointedTimeToDateTimeConverter x:Key="AppointedTimeToDateTimeConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid
        BindingContext="{x:Static vm:MainVM.Instance}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <HorizontalStackLayout
            Grid.Row="0">
            <TimePicker
                Time="{Binding NoteCouch.AppointedTime, Converter={StaticResource AppointedTimeToDateTimeConverter}, ConverterParameter={x:Type sys:TimeSpan}}"
                Format="HH:mm"/>
            <DatePicker
                Date="{Binding NoteCouch.AppointedTime, Converter={StaticResource AppointedTimeToDateTimeConverter}, ConverterParameter={x:Type sys:DateTime}}"
                Format="d"
                MinimumDate="{x:Static sys:DateTime.Today}"/>
        </HorizontalStackLayout>
        <Entry
            Grid.Row="1"
            Text="{Binding NoteCouch.Name}"
            Placeholder="Название"/>
        <Editor
            Grid.Row="2"
            Text="{Binding NoteCouch.Content}"
            Placeholder="Содержание"
            VerticalOptions="Fill"/>
        <Grid
            Grid.Row="3"
            Margin="0, 10, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Text="Сохранить"
                Margin="3"
                Command="{Binding SaveCommand}"/>
            <Button
                Grid.Column="1"
                Text="Отменить"
                Margin="3"
                Command="{Binding CancelCommand}"/>
        </Grid>
    </Grid>
    
</ContentPage>